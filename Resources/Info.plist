<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The template Scripts/build-brow.sh fills in: both version strings become
     BrowVersion.current (Sources/GroveCore/BrowVersion.swift), the one version of the
     app and the tool.
     macOS 26.4 keeps each bundle id's menu-bar layout in a cache that rapid relaunching
     can corrupt (the status item is then parked off-screen until a logout or a new id;
     Grove moved to dev.artemefimov.grove3 for that). Development builds therefore run
     as dev.artemefimov.brow.dev (Scripts/dev-run.sh), never under this id. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.artemefimov.brow</string>
	<key>CFBundleName</key>
	<string>Brow</string>
	<key>CFBundleDisplayName</key>
	<string>Brow</string>
	<key>CFBundleExecutable</key>
	<string>Brow</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Artem Efimov. GNU GPL v3.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Brow opens Terminal to sign in to Claude Code and to run the sessions you start there, and controls cmux to open and switch the sessions you start from Workspaces.</string>
</dict>
</plist>
